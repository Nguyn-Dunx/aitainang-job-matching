# Copy thành .env rồi điền giá trị thật. KHÔNG commit .env.

# PostgreSQL + pgvector (khớp với docker-compose.yml)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/aitainang

# LLM provider — NVIDIA NIM (OpenAI-compatible)
LLM_PROVIDER=openai
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=nvapi-your-key-here
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
LLM_FALLBACK_MODEL=nvidia/nemotron-3-super-120b-a12b
LLM_TIMEOUT_S=30
