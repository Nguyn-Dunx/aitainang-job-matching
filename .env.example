# Copy thành .env rồi điền giá trị thật. KHÔNG commit .env.

# PostgreSQL + pgvector (khớp với docker-compose.yml)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/aitainang

# LLM provider cho Tầng 2 (extraction) — chọn 1: openai | anthropic | google
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
